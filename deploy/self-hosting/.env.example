# Booskiff self-hosting stack configuration.
# Copy to `.env` next to compose.yml (`cp .env.example .env`) and edit.
# Every variable is optional: values left empty or unset fall back to the
# defaults shown, which produce a working internal-only stack.
#
# Variable names and semantics mirror core/src/config.rs.

# ---------------------------------------------------------------- database --
# Postgres credentials used by the postgres service. Keep them in sync with
# BOOSKIFF_DATABASE_URL below.
POSTGRES_USER=booskiff
POSTGRES_PASSWORD=changeme
POSTGRES_DB=booskiff

# Connection string core uses. The host must be the compose service name
# (`postgres`), not localhost. `DATABASE_URL` is accepted as a fallback name.
BOOSKIFF_DATABASE_URL=postgres://booskiff:changeme@postgres:5432/booskiff

# ------------------------------------------------------------------ server --
# Address core binds inside its container. Keep port 8080: it matches EXPOSE
# in the Containerfile and the compose healthcheck target.
BOOSKIFF_LISTEN_ADDR=0.0.0.0:8080

# Base URL used when core builds externally reachable absolute links.
# 18080 is the host port Caddy publishes on 127.0.0.1.
BOOSKIFF_PUBLIC_BASE_URL=http://127.0.0.1:18080

# Optional tracing filter (RUST_LOG syntax), e.g. `info` or `debug`.
RUST_LOG=info

# ------------------------------------------------------------- object store --
# MinIO root credentials (minio service). Keep them in sync with
# BOOSKIFF_S3_ACCESS_KEY / BOOSKIFF_S3_SECRET_KEY below.
MINIO_ROOT_USER=booskiff
MINIO_ROOT_PASSWORD=booskiff-secret

# S3 endpoint core talks to. Must be the compose service name (`minio`).
BOOSKIFF_S3_ENDPOINT=http://minio:9000

# Endpoint embedded into presigned URLs handed to clients. Leave empty to
# reuse BOOSKIFF_S3_ENDPOINT (correct while the stack stays internal-only;
# set e.g. http://127.0.0.1:18080/s3 only if you later expose MinIO publicly).
BOOSKIFF_S3_ENDPOINT_PUBLIC=

BOOSKIFF_S3_REGION=us-east-1
BOOSKIFF_S3_BUCKET=booskiff-default
BOOSKIFF_S3_ACCESS_KEY=booskiff
BOOSKIFF_S3_SECRET_KEY=booskiff-secret

# --------------------------------------------------------------------- JWT --
# Trusted JWT issuers, comma-separated. Each entry is `issuer` or
# `issuer|jwks_url`; an empty `|jwks_url` part defaults to
# `{issuer}/.well-known/jwks.json`. Example:
#   BOOSKIFF_JWT_TRUSTED_ISSUERS=https://auth.example.com|https://keys.example.com/jwks.json,https://other.example.com
# Empty = no trusted issuers (authenticated endpoints stay unusable until set).
BOOSKIFF_JWT_TRUSTED_ISSUERS=

# Optional expected `aud` claim. Empty = audience not checked.
BOOSKIFF_JWT_AUDIENCE=

# Claim carrying the owner type in access tokens.
BOOSKIFF_JWT_OWNER_TYPE_CLAIM=owner_type

# -------------------------------------------------------------------- plans --
# How premium limits are assigned: `everyone` (all owners get premium limits)
# or `mirror` (only owners with a premium plan assignment).
BOOSKIFF_PREMIUM_MODE=everyone

# Payment provider wiring. Only `none` / `disabled` exist today.
BOOSKIFF_PAYMENT_PROVIDER=disabled

# Default plan limits.
BOOSKIFF_PLAN_DEFAULT_STORAGE_QUOTA_BYTES=1073741824
BOOSKIFF_PLAN_DEFAULT_MAX_FILE_BYTES=104857600
BOOSKIFF_PLAN_DEFAULT_RATE_LIMIT_RPM=100

# Premium plan limits (applied per BOOSKIFF_PREMIUM_MODE).
BOOSKIFF_PLAN_PREMIUM_STORAGE_QUOTA_BYTES=10737418240
BOOSKIFF_PLAN_PREMIUM_MAX_FILE_BYTES=524288000
BOOSKIFF_PLAN_PREMIUM_RATE_LIMIT_RPM=300

# TTL for presigned download URLs, in seconds.
BOOSKIFF_PRESIGNED_GET_TTL_SECS=900

# -------------------------------------------------------------------- admin --
# Set to seed the first admin token; rotate by changing value and restarting.
# The token is seeded into `admin_tokens` (name `bootstrap`) on startup when
# no active token with that hash exists yet; restarts with the same value are
# idempotent. Empty = no bootstrap token is seeded.
BOOSKIFF_ADMIN_BOOTSTRAP_TOKEN=
